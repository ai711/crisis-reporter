{
  "expo": {
    "name": "Crisis Reporter",
    "slug": "crisis-reporter",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#1A2B4A"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "org.undp.crisisreporter"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#1A2B4A"
      },
      "package": "org.undp.crisisreporter",
      "permissions": [
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.CAMERA",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.POST_NOTIFICATIONS",
        "android.permission.READ_PHONE_STATE",
        "android.permission.INTERNET",
        "android.permission.ACCESS_NETWORK_STATE",
        "android.permission.RECEIVE_BOOT_COMPLETED"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-secure-store",
      "@maplibre/maplibre-react-native",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Crisis Reporter needs your location to identify the building you are reporting."
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/icon.png",
          "color": "#0468B1",
          "defaultChannel": "crisis-reports"
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Crisis Reporter needs camera access to photograph damage."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Crisis Reporter needs photo library access to attach damage photos."
        }
      ],
      "expo-task-manager",
      "expo-background-fetch"
    ],
    "extra": {
      "eas": {
        "projectId": "8cdcae5d-9452-4d00-8bfe-e2f4a73e1ab1"
      }
    }
  }
}