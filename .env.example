# Map
MAPTILER_API_KEY=

# Web Push
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# Expo Push
EXPO_PUSH_TOKEN=

# IP Geolocation (Rule 7 — IP country mismatch)
# Free tier: 45 req/min (Redis cache keeps effective rate well below this).
# Set IPAPI_KEY if WARNING logs appear under sustained load ($15/mo for 15k req/min).
IPAPI_KEY=

