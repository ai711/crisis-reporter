# Database
DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/crisis_reporter

# Redis
REDIS_URL=redis://localhost:6379

# JWT
JWT_SECRET_KEY=your-secret-key-here

# Encryption
FERNET_KEY=your-fernet-key-here

# Storage
STORAGE_BACKEND=local
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
